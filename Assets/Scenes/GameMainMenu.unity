MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1132646019}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 21c35fbd1effa234fa0a8ea01eb77e41, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneManager
  pages:
  - backgroundImage: {fileID: -6525251533827417197, guid: 95b23d7de7320b3489db5ffa42649cd1, type: 3}
    narrativeText: "Sau nhi\u1EC1u th\u1EBF k\u1EF7 y\xEAn b\xECnh, m\u1EB7t \u0111\u1EA5t
      n\u1EE9t to\xE1c v\xE0 m\u1ED9t th\xE1p \u0111\xE1 \u0111en kh\u1ED5ng l\u1ED3
      tr\u1ED7i d\u1EADy t\u1EEB l\xF2ng l\u1EE5c \u0111\u1ECBa: Ng\u1EE5c T\u1ED1i
      V\u1EF1c S\xE2u (The Abyssal Dungeon)."
    duration: 10
    pageAudio: {fileID: 0}
  - backgroundImage: {fileID: -154269249030348198, guid: 1cb8cc932f6f0934fb23344d6b7e6e40, type: 3}
    narrativeText: "Qu\xE1i v\u1EADt tr\xE0n ra t\xE0n ph\xE1 l\xE0ng m\u1EA1c v\xE0
      v\u01B0\u01A1ng qu\u1ED1c, bi\u1EBFn r\u1EEBng r\u1EADm v\xE0 s\xF4ng ng\xF2i
      th\xE0nh nh\u1EEFng v\xF9ng \u0111\u1EA5t ch\u1EBFt tha h\xF3a."
    duration: 10
    pageAudio: {fileID: 0}
  - backgroundImage: {fileID: -7465307106225235979, guid: 408f515dd794804439b4a53e0b8dd002, type: 3}
    narrativeText: "Ng\u1EE5c t\u1ED1i th\u1EF1c ch\u1EA5t l\xE0 phong \u1EA5n th\u1EA7n
      th\xE1nh giam gi\u1EEF C\u1EF1 Long H\u1EE7y Di\u1EC7t (The Devouring Dragon).
      Nh\u01B0ng gi\u1EDD \u0111\xE2y, phong \u1EA5n \u1EA5y \u0111ang d\u1EA7n s\u1EE5p
      \u0111\u1ED5."
    duration: 10
    pageAudio: {fileID: 0}
  - backgroundImage: {fileID: -7083523246791027351, guid: 34d861958761f404fb90b9ec6a60eae4, type: 3}
    narrativeText: "M\u1ED9t nh\xF3m ng\u01B0\u1EDDi b\xECnh th\u01B0\u1EDDng may
      m\u1EAFn s\u1ED1ng s\xF3t, th\u1EE9c t\u1EC9nh v\u1EDBi nh\u1EEFng d\u1EA5u
      \u1EA5n h\xECnh r\u1ED3ng r\u1EF1c ch\xE1y tr\xEAn tay - ph\u01B0\u1EDBc l\xE0nh
      c\u1EE7a c\xE1c v\u1ECB th\u1EA7n \u0111\xE3 khu\u1EA5t."
    duration: 10
    pageAudio: {fileID: 0}
  - backgroundImage: {fileID: -6047493898223882553, guid: 8357cf4dc62203948b31a876b00eda5e, type: 3}
    narrativeText: "B\u1ECB d\u1EABn d\u1EAFt b\u1EDFi s\u1ED1 ph\u1EADn v\xE0 th\xF9
      h\u1EADn, nh\u1EEFng ng\u01B0\u1EDDi anh h\xF9ng l\xEAn \u0111\u01B0\u1EDDng
      ti\u1EBFn v\xE0o l\xF2ng Ng\u1EE5c T\u1ED1i V\u1EF1c S\xE2u \u0111\u1EC3 t\xECm
      ki\u1EBFm c\xE2u tr\u1EA3 l\u1EDDi."
    duration: 10
    pageAudio: {fileID: 0}
  - backgroundImage: {fileID: 5787426498330204712, guid: ece8978f0a0ad06428533ec6c565bed2, type: 3}
    narrativeText: "C\xE0ng ti\u1EBFn s\xE2u xu\u1ED1ng c\xE1c t\u1EA7ng ng\u1EE5c,
      qu\xE1i v\u1EADt c\xE0ng m\u1EA1nh m\u1EBD h\u01A1n, v\xE0 C\u1EF1 Long c\u1ED5
      x\u01B0a d\u01B0\u1EDBi l\xF2ng \u0111\u1EA5t c\u0169ng \u0111ang d\u1EA7n
      th\u1EE9c gi\u1EA5c."
    duration: 10
    pageAudio: {fileID: 0}
  backgroundImage: {fileID: 1949626014}
  narrativeText: {fileID: 1579463477}
  fadeOverlay: {fileID: 33958731}
  skipIndicator: {fileID: 1470431723}
